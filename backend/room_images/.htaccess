# Room showcase photos are deliberately public — guests browsing Preview.jsx
# have no session, so unlike backend/uploads/ (Require all denied,
# download_file.php-only) these are served directly. Directory listing and
# script execution are still blocked.

Options -Indexes

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|phar|pht|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
