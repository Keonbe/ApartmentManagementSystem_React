# Full URL of the PHP API folder, including the trailing slash.
#
# Vite picks the value by mode:
#   npm run dev                          -> .env.development (local XAMPP)
#   npm run build                        -> .env.production  (Railway)
#   npm run build -- --mode development  -> .env.development (dist/ served by XAMPP)
# Copy this file to .env.local (gitignored) to override both on your machine.
#
# Local XAMPP:
VITE_API_BASE_URL=http://localhost:8080/ApartmentManagementSystem_React/backend/api/
# Railway (backend is the web root, so endpoints live under /api/):
# VITE_API_BASE_URL=https://apartmentmanagementsystemreact-production.up.railway.app/api/
