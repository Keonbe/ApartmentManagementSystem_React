# Frontend build targets — one Vite mode per deployment:
#
#   npm run dev               -> .env.development  (local XAMPP)
#   npm run build:local       -> .env.development  (dist/ served by XAMPP)
#   npm run build:saas        -> .env.production   (CI build; same as `npm run build`)
#   npm run build:selfhosted  -> .env.selfhosted   (copy from .env.selfhosted.example)
#
# Any mode can be overridden per machine with .env.<mode>.local (gitignored),
# or with real environment variables on the build host.
# Every VITE_* value is published in the bundle: never put secrets here.
#
# VITE_DEPLOYMENT_TARGET  local | saas | selfhosted
# VITE_API_BASE_URL       full URL of the PHP API folder, trailing slash (required for builds)
# VITE_PUBLIC_URL         public URL of the SPA, for payment return links (default: current page)
# VITE_CHAT_SOCKET_URL    optional Socket.IO service origin (default: localhost:3001 in dev, current origin in production)
VITE_DEPLOYMENT_TARGET=local
VITE_API_BASE_URL=http://localhost:8080/ApartmentManagementSystem_React/backend/api/
