# Target: local XAMPP. Used by `npm run dev` and `npm run build:local`
# (dist/ served by XAMPP). No secrets — VITE_* values end up in the bundle.
VITE_DEPLOYMENT_TARGET=local
# API: keep exactly one line uncommented, then restart `npm run dev` / rebuild.
# Local XAMPP backend:
 VITE_API_BASE_URL=http://localhost:8080/ApartmentManagementSystem_React/backend/api/ # Local XAMPP backend
# VITE_API_BASE_URL=http://192.168.1.215:8080/ApartmentManagementSystem_React/backend/api/ # Production backend on local network (XAMPP)
