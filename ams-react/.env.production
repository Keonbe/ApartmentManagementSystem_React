# Target: SaaS (Railway). Used by `npm run build` / `npm run build:saas`.
# No secrets — VITE_* values end up in the public bundle.
# Override on the host (Vercel/Railway build variables) or in .env.production.local.
VITE_DEPLOYMENT_TARGET=saas
VITE_API_BASE_URL=https://apartmentmanagementsystemreact-production.up.railway.app/api/
# Optional: uploads live under the backend root by default.
# VITE_ASSET_BASE_URL=https://apartmentmanagementsystemreact-production.up.railway.app/
# Optional: public URL of this frontend (payment return links).
# VITE_PUBLIC_URL=https://<saas-frontend-domain>/
