# Production-mode build (`npm run build` / `npm run build:saas`), as run by CI. The URL is a placeholder;
# real deployments use .env.selfhosted (`npm run build:selfhosted`).
# No secrets — VITE_* values end up in the public bundle.
# Override in .env.production.local.
VITE_DEPLOYMENT_TARGET=saas
VITE_API_BASE_URL=https://ams.example.com/api/
# Optional: uploads live under the backend root by default.
# VITE_ASSET_BASE_URL=https://ams.example.com/
# Optional: public URL of this frontend (payment return links).
# VITE_PUBLIC_URL=https://<frontend-domain>/
