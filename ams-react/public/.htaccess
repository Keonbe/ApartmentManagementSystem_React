# Copied into dist/ by Vite. index.html must be revalidated on every load, or a
# browser keeps pointing at the previous build's hashed bundle after a rebuild.
# The hashed files under assets/ never change, so they can be cached for good.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
