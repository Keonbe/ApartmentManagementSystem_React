# Target: self-hosted (another operator's server). Copy to `.env.selfhosted`
# (gitignored), fill in, then `npm run build:selfhosted`.
# No secrets — VITE_* values end up in the public bundle.
VITE_DEPLOYMENT_TARGET=selfhosted
# Full URL of that server's PHP API folder, with trailing slash.
#   Apache/XAMPP layout:  https://ams.example.org/ApartmentManagementSystem_React/backend/api/
#   Docker layout:        https://ams.example.org/api/
VITE_API_BASE_URL=https://ams.example.org/ApartmentManagementSystem_React/backend/api/
# Optional overrides (defaults shown in docs/deployment/dual-deployment-environment-plan.md §4)
# VITE_ASSET_BASE_URL=https://ams.example.org/ApartmentManagementSystem_React/backend/
# VITE_PUBLIC_URL=https://ams.example.org/ApartmentManagementSystem_React/ams-react/dist/index.html
