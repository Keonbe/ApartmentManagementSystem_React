# Self-hosted backend running under Docker or an Apache vhost with SetEnv/env
# files. On XAMPP use backend/config.env.php instead (same names, as define()).
# Copy to deploy/env/selfhosted.env (gitignored) and pass it with
#   docker run --env-file deploy/env/selfhosted.env ...
APP_ENV=production
DEPLOYMENT_TARGET=selfhosted
DEPLOYMENT_ID=<org>-selfhosted
APP_URL=https://ams.example.org
ALLOWED_ORIGINS=https://ams.example.org

# This operator's own database server and account — never the SaaS ones.
DB_HOST=db.internal
DB_PORT=3306
DB_USER=ams_app
DB_PASS=<strong password>
DB_NAME=ams_selfhosted

# Their own PayMongo account (or leave unset and use Admin > Settings).
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=
# Uploads: mount a host directory of their own at /var/www/html/uploads.
