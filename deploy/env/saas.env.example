# SaaS backend (Railway service variables). Template only — set the real values
# in the Railway dashboard; never commit a filled copy (deploy/env/*.env is ignored).
# PHP reads these at runtime; changing one needs a redeploy/restart, not a rebuild.
APP_ENV=production
DEPLOYMENT_TARGET=saas
DEPLOYMENT_ID=saas-prod
APP_URL=https://<saas-frontend-domain>
ALLOWED_ORIGINS=https://<saas-frontend-domain>

# Reference the Railway MariaDB service; do not paste literal credentials.
DB_HOST=${{MariaDB.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=3306
DB_USER=${{MariaDB.MARIADB_USER}}
DB_PASS=${{MariaDB.MARIADB_PASSWORD}}
DB_NAME=${{MariaDB.MARIADB_DATABASE}}

# Optional: override the PayMongo keys stored in Admin > Settings.
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=
# Uploads: attach a Railway volume at /var/www/html/uploads (not shared with any other service).
