includes:
    - phpstan-baseline.neon

parameters:
    level: 0
    phpVersion: 80000 # production runs PHP 8.0; CI's setup-php image is newer
    bootstrapFiles:
        - backend/vendor/autoload.php
    paths:
        - backend
    excludePaths:
        - backend/uploads/*
        - backend/api/migrations/*
        - backend/vendor/*
