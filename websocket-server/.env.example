# Chat server (websocket-server/server.js). Copy to .env; these are also the built-in defaults.
# It reads the same `sessions` and `messages` tables as the PHP API, so DB_* must point at the app's database.
DB_HOST=localhost
# DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ams_db
PORT=3001

# Browser origins allowed to connect, comma separated. Leave unset to use the
# same list as backend/cors.php. Set it explicitly in production.
# ALLOWED_ORIGINS=https://angcanan-ams.com,https://www.angcanan-ams.com

# Session clock for messages.created_at; must match APP_TIMEZONE (Asia/Manila = +08:00).
# DB_TIME_ZONE=+08:00
